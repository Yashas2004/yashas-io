# Copy to .env.local and fill in. Never commit real keys.

# ── Portfolio assistant (/api/assistant) ─────────────────────────────────────
# Primary provider: Groq (free key at https://console.groq.com/keys)
GROQ_API_KEY=
# Fallback provider: Google Gemini (free key at https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model overrides (defaults shown)
ASSISTANT_MODEL=openai/gpt-oss-20b
ASSISTANT_FALLBACK_MODEL=gemini-3.5-flash-lite

# ── Contact form (/api/contact) ──────────────────────────────────────────────
# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Optional: inbox to deliver to, and the sender address
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
